# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Jamendo API Configuration (Primary Full-Track Music Provider)
# ==============================================================================
# Jamendo provides full-length track streaming and authorized downloads under
# Creative Commons licenses.
#
# How to get your free Jamendo API Client ID:
# 1. Register for a free developer account at: https://developer.jamendo.com/
# 2. Click "My Apps" -> "Create an app"
# 3. Choose "Read only" or "Read & Write" plan (Free tier gives up to 35,000 requests/month)
# 4. Copy your generated "Client ID" (an 8-character hex string)
# 5. Add it to your local environment file (.env.local):
#      VITE_JAMENDO_CLIENT_ID="your_client_id_here"
#
# Note: Vite exposes variables prefixed with VITE_ to the browser bundle.
# The Jamendo client_id is a public identifier used for client-side API authentication.
VITE_JAMENDO_CLIENT_ID="YOUR_JAMENDO_CLIENT_ID"

# ==============================================================================
# Apple iTunes Search API (Fallback Preview Catalog)
# ==============================================================================
# Used as a graceful fallback for tracks not present in Jamendo's catalog.
# iTunes streams are labelled ~30s audio previews.
VITE_MUSIC_PROVIDER="itunes"
VITE_MUSIC_API_URL="https://itunes.apple.com"
